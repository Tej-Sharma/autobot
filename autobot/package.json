{
  "name": "autobot",
  "version": "1.0.0",
  "private": true,
  "description": "Autobot visual + playwright QA service for constella website deployments",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:all": "sh -c 'node dist/server.js & node dist/worker.js; wait'",
    "format": "npx prettier -w src/**/*.ts",
    "docker:build": "docker build -t autobot:local .",
    "docker:compose:up": "docker compose up --build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.37",
    "@octokit/rest": "^20.0.2",
    "@playwright/test": "^1.54.0",
    "bullmq": "^5.25.3",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "ioredis": "^5.4.2",
    "openai": "^4.71.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
