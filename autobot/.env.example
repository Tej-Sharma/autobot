# Core
NODE_ENV=production
PORT=4000
REDIS_URL=redis://redis:6379
QUEUE_NAME=autobot-qa
WORKER_CONCURRENCY=2
JOB_STATUS_TTL_SECONDS=172800
ARTIFACT_ROOT=./artifacts
ARTIFACT_RETENTION_DAYS=14

# GitHub
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
# GITHUB_TOKEN is optional fallback for cases where per-user OAuth token is unavailable.
# Prefer user OAuth tokens from github-web (recommended for self-serve flow).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_ALLOWED_REPOS=owner/repo,other/website
APP_BASE_URL=https://your-app-url.com
AUTOBOT_WEBHOOK_URL=
AUTOBOT_API_TOKEN=

# URL strategy
BASE_URL_PRODUCTION=https://example.com
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
MAX_ROUTES_PER_RUN=10
DEFAULT_ROUTES=home,pricing,trial,features,downloads,blog,legal
DEFAULT_VIEWPORTS=desktop:1280x720,mobile:390x844
DEFAULT_MODE=smoke
DEFAULT_JUDGE=true
AUTO_RUN_PREVIEW_ON_PR_OPEN=true
AUTO_RUN_PREVIEW_ON_PR_SYNC=true

# OpenAI (for QA judge)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=700
OPENAI_RETRIES=2
OPENAI_TIMEOUT_MS=30000

# Quality gates
QA_FAIL_ON_BLOCKING=true
QA_FAIL_ON_HIGH_THRESHOLD=1
QA_MIN_SCORE=78

# AI App Tester (Claude Agent SDK)
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001
AGENT_MAX_BUDGET_USD=5

# Fly.io (managed environments)
FLY_API_TOKEN=
FLY_APP_NAME=autobot-envs
FLY_REGION=sjc
FLY_AGENT_SECRET=
