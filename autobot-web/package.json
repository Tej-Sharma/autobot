{
  "name": "autobot-web",
  "version": "1.0.0",
  "private": true,
  "description": "Autobot landing + GitHub auth/dashboard for PR-driven QA",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
