PORT=4173

# Backend base URL used by Next.js rewrite for /api/*
AUTOBOT_API_BASE_URL=http://localhost:4000

# GitHub OAuth (set these for login to work)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Webhook & API auth (must match autobot backend)
AUTOBOT_WEBHOOK_URL=
AUTOBOT_API_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Session config
SESSION_TTL_MS=604800000
AUTH_STATE_TTL_MS=900000

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
